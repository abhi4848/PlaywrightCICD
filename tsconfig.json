{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "playwright", "@playwright/test"]
  },
  "include": ["PlaywrightTest/**/*.ts", "playwright.config.ts", "playwright.config.js"],
  "exclude": ["node_modules"]
}
